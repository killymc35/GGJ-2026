  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022  Each suspect is known to use one unique signature weapon.\n\r\n\u2022 
    Two of four suspects wear a tie. Two of four suspects wear a hat. \u2022  Two
    suspects wear a half-mask, and two suspects wear a full mask.\r\n\u2022  There
    was only one suspect in the mansion at each time of day, and they each visited
    a different room.\r\n\u2022  Therefore each weapon was only in one location,
    at one time.\n\r\n\u2022  There are two types of cards, fact cards and special
    cards. Special cards can have more valuable information, but cost more time to
    investigate. There are 3 types of special cards, WHO, WHERE, and WHEN."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 912029b04c45e5249b9f1c726471cf62, type: 2}
  m_sharedMaterial: {fileID: 2904877867313925585, guid: 912029b04c45e5249b9f1c726471cf62, type: 2}
